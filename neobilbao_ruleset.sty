% --- Macros de texto ----------------------------------------------------
\newcommand{\etiqueta}[1]{\textcolor{AcidSirimiri}{\textsf{\bfseries[#1]}}}
\newcommand{\lead}[1]{\textsf{\bfseries\textcolor{BurdinUrdin}{#1}}}
\newcommand{\dire}[1]{\textsf{\bfseries\textcolor{OrekakRust}{#1}}}
\newcommand{\cine}[1]{\textsf{\bfseries\textcolor{CupulaGold}{\MakeUppercase{#1}}}}
\newcommand{\codigo}[1]{\textcolor{BurdinUrdin}{\terminalfont\small #1}}

\newcommand{\neofigure}[2]{%
  \begin{figure}[tbp]
  \centering
  \includegraphics[width=\linewidth]{#1}\par
  \vspace{1mm}{\color{BurdinUrdin}\rule{0.22\linewidth}{0.8pt}}\par
  \caption{#2}
  \end{figure}}

% --- Cajas tcolorbox ----------------------------------------------------
\tcbset{
  neo/.style={
    enhanced, breakable,
    arc=0.8mm, boxrule=0.7pt,
    left=7pt, right=7pt, top=5pt, bottom=5pt,
    before skip=8pt, after skip=8pt,
    coltitle=white, fonttitle=\industrialfont\bfseries\small,
    before title={\textcolor{CupulaGold}{//}\hspace{0.4em}},
    before upper={\setlength{\parindent}{0pt}\setlength{\parskip}{0.4em plus 0.1em}\raggedright},
    colupper=CarbonDark,
  }
}

\newtcolorbox{CajaRegla}[1]{neo,
  colframe=BurdinUrdin, colback=BoxBlue, colbacktitle=BurdinUrdin,
  title={\MakeUppercase{#1}}}

\newtcolorbox{CajaAmbientacion}[1]{neo,
  colframe=OrekakRust, colback=BoxRust, colbacktitle=OrekakRust,
  title={\MakeUppercase{#1}}}

\newtcolorbox{CajaEjemplo}[1]{neo,
  colframe=AcidSirimiri, colback=BoxGreen, colbacktitle=AcidSirimiri,
  title={\MakeUppercase{#1}}}

\newtcolorbox{FichaArquetipo}[1]{neo,
  colframe=GoldDark, colback=BoxGold, colbacktitle=GoldDark,
  title={\MakeUppercase{#1}}}

\newtcolorbox{FichaEnemigo}[1]{neo,
  colframe=CarbonDark, colback=BoxGray, colbacktitle=CarbonDark,
  title={\MakeUppercase{#1}}}

