% --- Idioma y formatos ---------------------------------------------------
\renewcommand{\contentsname}{Índice General}
\renewcommand{\chaptername}{Capítulo}
\renewcommand{\partname}{Parte}
\renewcommand{\figurename}{Figura}

\emergencystretch=2em

\color{CarbonDark}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.5em plus 0.2em minus 0.1em}
\setcounter{tocdepth}{1}

\setlist{leftmargin=1.4em,itemsep=2pt,topsep=3pt,parsep=0pt}

% --- Titulares ----------------------------------------------------------
\titleformat{\chapter}[display]
  {\raggedright\normalfont}
  {\industrialfont\bfseries\small\color{BurdinUrdin}NEOBILBAO // GUÍA DE JUEGO // \MakeUppercase{\chaptername}~\thechapter}
  {4pt}
  {\industrialfont\bfseries\LARGE\color{CarbonDark}}
  [\vspace{4pt}{\color{OrekakRust}\titlerule[1.2pt]}]
\titlespacing*{\chapter}{0pt}{0pt}{16pt}

\titleformat{\section}{\industrialfont\bfseries\large\color{OrekakRust}\raggedright}{\thesection}{0.6em}{}
\titlespacing*{\section}{0pt}{2.2ex plus .5ex minus .2ex}{1ex plus .2ex}
\titleformat{\subsection}{\industrialfont\bfseries\normalsize\color{BurdinUrdin}\raggedright}{\thesubsection}{0.6em}{}
\titlespacing*{\subsection}{0pt}{1.8ex plus .4ex minus .2ex}{.6ex plus .1ex}
\titleformat{\subsubsection}{\industrialfont\bfseries\small\color{GoldDark}\raggedright}{\thesubsubsection}{0.6em}{}
\titlespacing*{\subsubsection}{0pt}{1.4ex plus .3ex minus .2ex}{.4ex}

\makeatletter
\def\@part[#1]#2{%
  \ifnum \c@secnumdepth >-2\relax
    \refstepcounter{part}%
    \addcontentsline{toc}{part}{\thepart\hspace{1em}#1}%
  \else
    \addcontentsline{toc}{part}{#1}%
  \fi
  {\parindent\z@ \centering \interlinepenalty\@M \normalfont
    \vspace*{\fill}%
    {\industrialfont\bfseries\large\color{OrekakRust}\MakeUppercase{\partname}~\thepart\par}%
    \vskip 12\p@
    {\industrialfont\bfseries\Huge\color{CarbonDark}#2\par}%
    \vspace*{\fill}\par}%
  \@endpart}
\makeatother

