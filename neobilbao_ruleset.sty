\definecolor{NeonAmber}{HTML}{D97706}        % Ámbar de pantallas noventeras
\definecolor{InkSoft}{HTML}{4B5358}          % Tinta suave para tablas y textos secundarios

\colorlet{GoldDark}{CupulaGold!70!black}
\colorlet{SteelLight}{CarbonDark!12!white}
